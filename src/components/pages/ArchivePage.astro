---
import ArchivePanel from "@components/ArchivePanel.svelte";
import EmptyPosts from "@components/EmptyPosts.astro";
import { getLocale } from "@i18n/locale";
import I18nKey from "@i18n/i18nKey";
import { i18n } from "@i18n/translation";
import MainGridLayout from "@layouts/MainGridLayout.astro";
import { getSortedPostsList } from "@utils/content-utils";

const locale = getLocale(Astro.url);
const sortedPostsList = await getSortedPostsList(locale);
---

<MainGridLayout title={i18n(I18nKey.archive, locale)}>
    {sortedPostsList.length > 0
        ? <ArchivePanel locale={locale} sortedPosts={sortedPostsList} client:only="svelte"></ArchivePanel>
        : <EmptyPosts />}
</MainGridLayout>
