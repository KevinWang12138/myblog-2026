---
import type { CollectionEntry } from "astro:content";
import type { Page } from "astro";
import Pagination from "../control/Pagination.astro";
import EmptyPosts from "../EmptyPosts.astro";
import PostPage from "../PostPage.astro";
import MainGridLayout from "../../layouts/MainGridLayout.astro";
interface Props { page: Page<CollectionEntry<"posts">> }
const { page } = Astro.props;
const len = page.data.length;
---
<MainGridLayout>
    {len > 0 ? <>
        <PostPage page={page} />
        <Pagination class="mx-auto onload-animation" page={page} style={`animation-delay: calc(var(--content-delay) + ${len * 50}ms)`} />
    </> : <EmptyPosts />}
</MainGridLayout>
