---
import { getSortedPosts } from "@utils/content-utils";
import { getPublicSlug } from "@utils/url-utils";
import PostDetail from "../../../components/pages/PostDetail.astro";
export async function getStaticPaths() {
	return (await getSortedPosts("en")).map((entry) => ({
		params: { slug: getPublicSlug(entry.slug) }, props: { entry },
	}));
}
const { entry } = Astro.props;
---
<PostDetail entry={entry} />
